    },
    "Choose the active season once. It applies to every plant using seasonal watering intervals." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只需选择一次当前季节，所有启用按季节浇水间隔的植物都会使用它。"
          }
        }
      }
    },
    "Choose the months when pruning is best for this plant." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择适合修剪这株植物的月份。"
