{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {

    },
    "‘Thai Constellation’" : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘Thai Constellation’"
          }
        }
      }
    },
    "“Low light” does not mean darkness. Every plant needs usable light, and each species has its own range." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“低光照”不等于黑暗。所有植物都需要能利用的光，只是每种植物适应的范围不同。"
          }
        }
      }
    },
    "%@ · %@" : {
