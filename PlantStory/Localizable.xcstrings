    "Make it yours. Change the colors, add new ideas, and start vibe coding your own version." : {
      "comment" : "A description of the customization feature of PlantStory.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
