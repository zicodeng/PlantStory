    "Ferns and their relatives have vascular tissue that moves water through the plant, but they reproduce with spores rather than seeds." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "蕨类及近缘植物具有在体内输送水分的维管组织，但它们通过孢子而不是种子繁殖。"
          }
        }
      }
    },
