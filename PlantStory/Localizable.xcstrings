    "Find a dry, shaped mark at a node where no leaf is currently attached." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在目前没有叶片的节上寻找干燥、有形状的痕迹。"
          }
        }
      }
    },
    "Find a houseplant family" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查找室内植物的家族"
          }
        }
      }
    },
    "FIND A PLANT’S FAMILY" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找到植物的家族"
          }
        }
      }
    },
    "Find it at the base of the pistil, below the style and stigma." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它位于雌蕊底部，在花柱和柱头的下方。"
          }
        }
      }
    },
    "Find the end of the leaf where its two margins meet." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "叶片两侧边缘汇合的末端就是叶尖。"
          }
        }
      }
    },
    "Find the main upright structure that leaves, buds, and branches grow from." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找到叶、芽和枝条共同长出的主要直立结构。"
          }
        }
      }
    },
    "Find the newest folded or tightly clustered growth at the end of the stem." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在茎的末端寻找最新的折叠状或紧密簇生的新生组织。"
          }
        }
      }
    },
    "FIND THE RIGHT SPOT" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找到合适的位置"
          }
        }
      }
    },
    "Find the slightly thickened area directly below the base of the stem." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在茎基部正下方寻找略微膨大的部位。"
          }
        }
      }
    },
    "Find the small green, leaflike structures directly behind or beneath the petals." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "花瓣后面或下方那些绿色、像小叶片一样的结构就是萼片。"
          }
        }
      }
    },
    "Find the viable part" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找到能繁殖的部位"
          }
        }
      }
    },
    "Find the yellow or dusty-looking shape at the end of each slender filament." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "细长花丝末端那些黄色或看起来覆有粉末的部分就是花药。"
          }
        }
      }
    },
    "Fine root" : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "细根"
          }
        }
      }
    },
    "Fine roots are the small, delicate branches that do much of the root system's water and mineral uptake." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "细根是细小脆弱的分枝，承担根系大部分水分和矿物质吸收工作。"
          }
        }
      }
    },
    "Fine roots dry out and become damaged faster than thick roots, so handle them gently when repotting." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "细根比粗根更容易干燥和受损，因此换盆时要轻柔处理。"
          }
        }
      }
    },
    "Fine webbing and pale speckles" : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "细网和密集浅色小点"
          }
        }
      }
    },
    "Firm roots with room for potting mix" : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根系结实，周围仍有盆土空间"
          }
        }
      }
    },
    "First step" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第一步"
          }
        }
      }
    },
    "Flaming Katy" : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长寿花"
          }
        }
      }
    },
    "Flamingo flower" : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "红掌"
          }
        }
      }
    },
    "Flower" : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "花"
          }
        }
      }
    },
    "Flower close-up" : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "花朵特写"
          }
        }
      }
    },
    "Flowering plants" : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开花植物"
          }
        }
      }
    },
    "Flowering plants, also called angiosperms, form flowers and enclose their seeds within an ovary that develops into a fruit." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开花植物也叫被子植物。它们会形成花，种子包在子房中，而子房之后会发育成果实。"
          }
        }
      }
    },
    "Flowers and fruit" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "花与果实"
          }
        }
      }
    },
    "Flowers can be tiny, seasonal, or easy to overlook. A plant does not need to be blooming now to belong to this group." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "花朵可能很小、只在特定季节出现，或很容易被忽略。植物现在没有开花，也依然可能属于这个类群。"
          }
        }
      }
    },
    "Flowers usually open from buds and may have colorful petals around their center." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "花通常由花芽绽放，中央周围常有颜色鲜艳的花瓣。"
          }
        }
      }
    },
    "Follow a lateral root outward to the thinnest branching roots near its ends." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沿侧根向外观察，在末端附近寻找最细的分枝根。"
          }
        }
      }
    },
    "Follow a leaf from growth point to maturity and learn which changes are normal." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "观察叶片从萌发到成熟的过程，读懂哪些变化属于正常生长。"
          }
        }
      }
    },
    "Follow a leaf inward until its narrow stalk reaches the main stem." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沿着叶片向内看，直到细长的柄与主茎相连。"
          }
        }
      }
    },
    "Follow a new leaf" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跟随一片新叶成长"
          }
        }
      }
    },
    "FOLLOW NEW GROWTH" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "观察新芽生长"
          }
        }
      }
    },
    "Follow one plant’s address" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顺着一株植物的分类地址往下走"
          }
        }
      }
    },
    "Follow the central structure downward from the stigma toward the flower base." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从柱头沿中央结构向下看，一直延伸到花朵底部。"
          }
        }
      }
    },
    "For many small and medium houseplants, choose a pot roughly 1–2 inches wider than the current one." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对多数中小型室内植物，新盆比旧盆宽约 2.5–5 厘米即可。"
          }
        }
      }
    },
    "Found %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发现于 %@"
          }
        }
      }
    },
    "Foxtail fern" : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foxtail fern"
          }
        }
      }
    },
    "Fresh tips signal active growth. Avoid tearing or crushing them when loosening roots during repotting." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新鲜根尖表示根系正在生长；换盆松根时不要撕裂或挤压它们。"
          }
        }
      }
    },
    "Friendship plant" : {
