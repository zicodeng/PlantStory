    "Moon Valley pilea" : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moon Valley pilea"
          }
        }
      }
    },
    "More light often means faster growth and faster drying. After changing a plant’s light, check its watering needs again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光照增加后，植物通常长得更快，盆土也干得更快。调整位置后，要重新观察它的浇水需求。"
          }
        }
      }
    },
    "Mosses and liverworts" : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "苔藓与地钱"
          }
        }
      }
    },
    "Mosses and liverworts belong to early branches of the land-plant family tree. They stay small and reproduce with spores rather than flowers, fruits, or seeds." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "苔藓和地钱位于陆生植物家族树较早分出的支系。它们体型小巧，通过孢子繁殖，不会开花、结果或产生种子。"
          }
        }
      }
    },
    "Mother of thousands" : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "落地生根"
          }
        }
      }
    },
    "Move around the pot so the whole root ball is moistened instead of wetting only one small area." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沿花盆四周缓慢浇水，让整个根团湿润，而不是只浇湿一小块。"
          }
        }
      }
    },
    "Move gradually" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "逐步增加光照"
          }
        }
      }
    },
    "Move the plant away from harsh midday sun or a strong draft while it recovers." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复期间，将植物移开强烈的正午阳光或强风口。"
          }
        }
      }
    },
    "Move the plant away from others, then inspect it in bright light." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先把这盆植物与其他植物分开，再放到明亮处仔细检查。"
          }
        }
      }
    },
    "Move to another iPhone" : {
