    },
    "Brown tips" : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "叶尖发褐"
          }
        }
      }
    },
    "Brown tips often appear before the rest of the leaf shows moisture or salt stress." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水分不合适或盐分积累时，叶尖往往最先变褐。"
          }
        }
      }
    },
    "Browse by family" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按科浏览"
          }
        }
      }
    },
    "Bud" : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "芽"
          }
        }
      }
    },
    "Build a simple habit: inspect the potting mix, water evenly when needed, and always let the excess escape." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "养成简单习惯：先检查盆土，需要时均匀浇透，并让多余水分完全流出。"
          }
        }
      }
    },
    "Bunny ears cactus" : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "黄毛掌"
          }
        }
      }
    },
    "Burro’s tail" : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "玉缀"
          }
        }
      }
    },
    "Cacti are American succulents with areoles—the small structures that produce spines, branches, or flowers." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仙人掌科是原产美洲的多肉植物，具有刺座——这种小结构会长出刺、枝条或花。"
          }
        }
      }
    },
    "Cactus family" : {
