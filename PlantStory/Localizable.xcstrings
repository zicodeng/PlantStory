    "Propagation Basics" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "繁殖入门"
          }
        }
      }
    },
    "Propagation is an experiment, not a promise. Start with one healthy piece, label it, and learn how that species responds before taking more." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "繁殖更像一次小实验，并非每次都保证成功。先从一份健康材料开始，做好标签，摸清这个品种的反应后再多取。"
          }
