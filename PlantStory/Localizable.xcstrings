    "Export Backup" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导出备份"
          }
        }
      }
    },
    "Extra humidity can reduce water loss, but trapped condensation and stale air can encourage disease." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适当提高湿度能减少水分流失，但闷住的水汽和不流通的空气也会增加病害风险。"
          }
        }
      }
    },
