    "Choose an existing location" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择已有位置"
          }
        }
      }
    },
    "Choose an offset or plantlet that has begun forming roots, or keep it attached while it roots when the species allows layering." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择已经开始长根的侧芽或小苗；如果品种适合压条，也可以先保持与母株相连，等生根后再分开。"
          }
        }
      }
    },
    "Choose any dot. You can revisit a part whenever you like." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击任意圆点，之后也可以随时回来复习。"
