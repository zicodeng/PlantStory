          "stringUnit" : {
            "state" : "translated",
            "value" : "叶片自然开孔或分裂"
          }
        }
      }
    },
    "Natural spots tend to look deliberate and repeat across healthy leaves. Spreading brown spots or yellow halos can indicate damage." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "天然斑点通常分布有规律，并会出现在多片健康叶子上。不断扩散的褐斑或黄色晕圈，可能说明叶片受损。"
          }
        }
      }
    },
    "Needs water" : {
      "extractionState" : "stale",
      "localizations" : {
