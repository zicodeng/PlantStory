    "Monstera sits on the flowering-plant branch—the largest major group in this beginner map." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "龟背竹属于开花植物分支，也是这张新手地图中最大的主要类群。"
          }
        }
      }
    },
    "Monstera, pothos, orchids, palms, grasses, and cacti." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "龟背竹、绿萝、兰花、棕榈、禾草和仙人掌。"
          }
        }
      }
    },
    "Monstera, pothos, philodendron, peace lily, anthurium, ZZ plant, and Chinese evergreen." : {
