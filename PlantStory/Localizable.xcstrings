    "White cottony insects collect in plant joints. Leaves may yellow, and the plant can feel sticky from honeydew." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "白色棉絮状小虫常聚集在叶片与茎的连接处。叶片可能发黄，虫体分泌的蜜露也会让植株摸起来发黏。"
          }
        }
      }
    },
